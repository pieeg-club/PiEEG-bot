# Anthropic API key for chat answers (https://console.anthropic.com/).
# Embeddings run locally via fastembed, so no key is needed for them.
ANTHROPIC_API_KEY=sk-ant-...

# Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=...

# Shared secret required in the X-API-Key header for POST /ask.
PIEEG_API_KEY=replace-with-a-long-random-secret

# --- Optional overrides (defaults shown) ---
# PIEEG_CHAT_MODEL=claude-haiku-4-5
# PIEEG_MAX_TOKENS=1024
# PIEEG_EMBED_MODEL=BAAI/bge-small-en-v1.5
# PIEEG_TOP_K=5
# PIEEG_MIN_SCORE=0.30
